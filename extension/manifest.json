{
  "manifest_version": 3,
  "name": "presentExs",
  "version": "1.0.0",
  "description": "Kontrol presentasi Google Slides dengan suara, subtitle, dan toolbar mengambang.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://cdn-lfs-us-1.huggingface.co/*",
    "https://cdn-lfs-eu-1.huggingface.co/*",
    "https://cdn-lfs.hf.co/*",
    "https://cdn.jsdelivr.net/*",
    "https://0.peerjs.com/*",
    "https://api.qrserver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "presentExs"
  }
}